{
	"name": "ca3d-sveltekit",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
		"db:migrate:local": "wrangler d1 execute ca3d-db --local --file=./schema.sql",
		"db:migrate:remote": "wrangler d1 execute ca3d-db --remote --file=./schema.sql",
		"db:cleanup:local": "wrangler d1 execute ca3d-db --local --file=./migrations/001-drop-legacy-tables.sql",
		"db:cleanup:remote": "wrangler d1 execute ca3d-db --remote --file=./migrations/001-drop-legacy-tables.sql",
		"db:add-rating:local": "wrangler d1 execute ca3d-db --local --file=./migrations/002-add-rating.sql",
		"db:add-rating:remote": "wrangler d1 execute ca3d-db --remote --file=./migrations/002-add-rating.sql"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24.0.0",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.49",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.7.2",
		"vite": "^7.3.7",
		"wrangler": "^4.149.0"
	}
}
