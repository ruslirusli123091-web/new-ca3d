{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "new-ca3d",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"vars": {
		"SITE_URL": "https://ca3d.site",
		"TURNSTILE_SITE_KEY": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "anime-db",
			"database_id": "1a5be1cb-adae-4862-b34e-6b014e56282c"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CA3D_SUBSCRIPTIONS",
			"id": "f394c8cae9014b9688f793b23adfef20"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		}
	]
}
