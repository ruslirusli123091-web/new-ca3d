# Copy this file to `.dev.vars` for local development.
# `.dev.vars` is gitignored and must never be committed.
#
# In production these are Cloudflare Pages secrets:
#   npx wrangler pages secret put SESSION_SECRET

# Signs the admin session cookie (HMAC-SHA256). Use a long random value.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Admin login. Credentials live in environment variables, never in the database,
# so a leaked D1 dump exposes no credentials.
#
# ADMIN_PASSWORD may be plain text, or a PBKDF2 hash produced by
#   node scripts/hash-password.mjs "YourPassword"
# in which case it looks like: pbkdf2$120000$<salt>$<hash>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public site URL, used for canonical links and the sitemap.
SITE_URL=http://localhost:5173

# Optional: Telegram notifications sent from the admin panel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
