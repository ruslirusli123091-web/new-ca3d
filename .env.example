# Copy this file to `.dev.vars` for local development.
# `.dev.vars` is gitignored and must never be committed.
#
# In production these are Cloudflare Pages secrets:
#   npx wrangler pages secret put SESSION_SECRET

# Signs the admin session cookie (HMAC-SHA256). Use a long random value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Cloudflare Turnstile (bot protection). Leave empty to disable in development.
# Dashboard: https://dash.cloudflare.com -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public site URL, used for sitemap and canonical links.
SITE_URL=http://localhost:5173

# Optional: Telegram notifications sent from the admin panel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
