# npm resolves peer dependencies strictly by default, which breaks this
# dependency graph: tailwindcss pulls picomatch v2 while vite/tinyglobby pull
# picomatch v4, and fdir declares picomatch as a peer dependency. npm then
# writes a lockfile that its own `npm ci` refuses to accept, so the Cloudflare
# Pages build fails with EUSAGE even though `npm install` succeeded locally.
#
# legacy-peer-deps tells npm to skip strict peer resolution. The lockfile and
# `npm ci` then agree, which is what the CI build needs.
legacy-peer-deps=true

# Keep installs reproducible and quiet in CI.
fund=false
audit=false
